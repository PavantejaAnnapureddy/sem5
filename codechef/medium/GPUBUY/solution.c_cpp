#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;
    
    while (T--) {
        long long X, Y, Z;
        cin >> X >> Y >> Z;
        if (Z <= Y) {
            cout << -1 << endl;
            continue;
        }
        long long diff = Z - Y;
        long long months = (X + diff - 1) / diff; 
        
        cout << months << endl;
    }
    
    return 0;
}
