#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    int N;
    cin >> N;
    
    vector<int> V(N), P(N);
    for (int i = 0; i < N; i++) cin >> V[i];
    for (int i = 0; i < N; i++) cin >> P[i];
    
    sort(V.begin(), V.end());
    sort(P.begin(), P.end());
    
    int j = 0;
    for (int i = 0; i < N && j < N; i++) {
        if (V[i] > P[j]) {
            j++; 
        }
    }
    
    cout << (j == N ? "Yes" : "No") << endl;
    return 0;
}